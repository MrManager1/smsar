{
  "name": "smsar-server",
  "version": "1.0.0",
  "description": "Backend server for smsar application",
  "main": "dist/server.js",
  "scripts": {
    "start": "tsc && node dist/server.js",
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "tsc",
    "serve-json": "json-server --watch src/data/db.json --port 5001",
    "start:public": "cross-env READ_ONLY=true node dist/server.js",
    "start:firestore": "USE_FIRESTORE=true npm run start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^11.11.0",
    "multer": "^2.0.2",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/json-server": "^0.14.8",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.5",
    "cross-env": "^7.0.3",
    "json-server": "^0.17.4",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
