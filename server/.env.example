# Example environment variables for running in production
PORT=5000
# If set to 'true' the server will use Firestore instead of db.json
USE_FIRESTORE=false

# If using Firestore, provide credentials in one of these ways:
# 1) Set FIREBASE_SERVICE_ACCOUNT_JSON with the raw service account JSON
# 2) Set FIREBASE_SERVICE_ACCOUNT_BASE64 with the base64-encoded JSON
# Example (base64):
# FIREBASE_SERVICE_ACCOUNT_BASE64=<base64-encoded-service-account-json>

# Optional read-only mode
READ_ONLY=false

# Optional admin token compatibility
ADMIN_TOKEN=
